generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PARENT
  COACH
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  COMPETITIVE
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  OPTED_OUT
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  coachProfile   CoachProfile?

  // Parent/guardian relationships for children managed by this account.
  children ParentStudent[]

  @@map("users")
}

model StudentProfile {
  id Int @id @default(autoincrement())

  // Nullable because a child may not have their own login account.
  userId Int? @unique

  name        String
  dateOfBirth DateTime
  phone       String?
  skillLevel  SkillLevel @default(BEGINNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  guardians   ParentStudent[]
  enrollments Enrollment[]

  @@map("student_profiles")
}

model ParentStudent {
  parentId  Int
  studentId Int

  // Examples: Mother, Father, Guardian.
  relationship String?

  createdAt DateTime @default(now())

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@map("parent_students")
}

model CoachProfile {
  id     Int @id @default(autoincrement())
  userId Int @unique

  bio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes Class[]

  @@map("coach_profiles")
}

model Class {
  id Int @id @default(autoincrement())

  coachId Int

  name      String
  classDate DateTime
  startTime DateTime
  endTime   DateTime
  venue     String
  capacity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Restrict)

  enrollments Enrollment[]

  @@map("classes")
}

model Enrollment {
  id Int @id @default(autoincrement())

  studentId Int
  classId   Int

  status EnrollmentStatus @default(PENDING)

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  payment Payment?

  // Prevent duplicate enrollment records for the same student/class pair.
  @@unique([studentId, classId])

  @@map("enrollments")
}

model Payment {
  id Int @id @default(autoincrement())

  enrollmentId Int @unique

  amount Decimal @db.Decimal(10, 2)
  status PaymentStatus @default(UNPAID)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}
